<Window x:Class="Lones.SptManager.App.ChooseProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose profile"
        Width="400"
        SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" Style="{DynamicResource AccentButton}" />
            <Button Content="Cancel" Width="80" Height="28" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ComboBox x:Name="ProfileBox" />
        </StackPanel>
    </DockPanel>
</Window>
