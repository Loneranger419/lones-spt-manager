<Window x:Class="Lones.SptManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lone's SPT Manager"
        Height="930"
        Width="1330"
        MinHeight="560"
        MinWidth="960"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
    <DockPanel>
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="8" KernelType="Gaussian" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ProfileIds}"
                          SelectedItem="{Binding ProfileId, Mode=TwoWay}"
                          SelectedValue="{Binding ProfileId, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Add" Width="64" Height="26" Margin="8,0,0,0" Command="{Binding AddProfileCommand}" />
                <Button Grid.Column="3" Content="Edit" Width="64" Height="26" Margin="6,0,0,0" Command="{Binding EditProfileCommand}" />
                <Button Grid.Column="4"
                        Content="Pack update"
                        Height="26"
                        MinWidth="96"
                        Margin="6,0,0,0"
                        Command="{Binding OpenPackUpdateCommand}"
                        ToolTip="{Binding PackUpdateSummary}"
                        Visibility="{Binding PackUpdateAvailable, Converter={StaticResource BoolToVis}}"
                        Style="{DynamicResource AccentButton}" />
                <TextBlock Grid.Column="5"
                           Text="Lone's SPT Manager"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0" />
                <Button Grid.Column="6"
                        Content="App update"
                        Height="26"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Command="{Binding OpenAppUpdateCommand}"
                        ToolTip="{Binding AppUpdateSummary}"
                        Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}"
                        Style="{DynamicResource AccentButton}" />
                <Button Grid.Column="7"
                        Content="Settings"
                        Width="80"
                        Height="26"
                        Command="{Binding SettingsCommand}" />
            </Grid>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Margin="4,2,4,6"
                           FontWeight="SemiBold"
                           Text="Installed mods  (0 loads first · drag to reorder · later number wins overlay)" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="4,0,4,2"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Filter" />
                <TextBox DockPanel.Dock="Top"
                         Margin="4,0,4,8"
                         Text="{Binding ModFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by name, folder, version, or leftover path" />
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="4,8,4,0">
                    <Button Content="Deploy" Height="30" Margin="0,0,4,0" Command="{Binding DeployCommand}" Style="{DynamicResource AccentButton}" />
                    <Button Content="Harvest" Height="30" Margin="4,0,0,0" Command="{Binding HarvestCommand}" />
                </UniformGrid>
                <ListBox x:Name="ModList"
                         ItemsSource="{Binding InventoryItems}"
                         SelectedItem="{Binding SelectedModRow}"
                         AllowDrop="True"
                         PreviewMouseRightButtonDown="ModList_PreviewMouseRightButtonDown"
                         PreviewMouseLeftButtonDown="ModList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ModList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="ModList_PreviewMouseLeftButtonUp"
                         DragOver="ModList_DragOver"
                         DragLeave="ModList_DragLeave"
                         Drop="ModList_Drop">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Enable" Command="{Binding EnableModCommand}" />
                            <MenuItem Header="Disable" Command="{Binding DisableModCommand}" />
                            <Separator />
                            <MenuItem Header="Move up (load earlier)" Command="{Binding PriorityUpCommand}" />
                            <MenuItem Header="Move down (load later)" Command="{Binding PriorityDownCommand}" />
                            <Separator />
                            <MenuItem Header="Import leftover into store" Command="{Binding ImportLeftoverCommand}" />
                            <MenuItem Header="Copy generated files to another profile" Command="{Binding CopyRuntimeCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PriorityLabel}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          VerticalAlignment="Center" />
                                <Grid Grid.Column="2" Width="36" Height="36" Margin="0,0,6,0" ClipToBounds="True">
                                    <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="3">
                                        <TextBlock Text="{Binding Initial}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Image Source="{Binding ThumbnailSource}"
                                           Width="36"
                                           Height="36"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2" Margin="8,0,4,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Instance" />
                    <TextBlock Text="Game root" Foreground="{DynamicResource MutedBrush}" />
                    <DockPanel Margin="0,2,0,8">
                        <Button DockPanel.Dock="Right" Content="Bind" Width="72" Height="26" Margin="6,0,0,0" Command="{Binding BindCommand}" />
                        <Button DockPanel.Dock="Right" Content="Browse" Width="72" Height="26" Margin="6,0,0,0" Command="{Binding BrowseGameRootCommand}" />
                        <TextBox Text="{Binding GameRoot, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,8" Text="Launch" />
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Button Content="Solo" Height="30" Margin="0,0,4,0" Command="{Binding LaunchSoloCommand}" Style="{DynamicResource AccentButton}" />
                        <Button Content="Fika host" Height="30" Margin="2,0,2,0" Command="{Binding LaunchFikaHostCommand}" Style="{DynamicResource AccentButton}" />
                        <Button Content="Fika join" Height="30" Margin="4,0,0,0" Command="{Binding LaunchFikaJoinCommand}" Style="{DynamicResource AccentButton}" />
                    </UniformGrid>
                    <TextBlock Text="Join URL (Fika join)" Foreground="{DynamicResource MutedBrush}" />
                    <TextBox Margin="0,2,0,8" Text="{Binding JoinUrl, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TabControl>
                    <TabItem Header="The Forge">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Search" Width="72" Height="26" Margin="6,0,0,0" Command="{Binding SearchForgeCommand}" />
                                <TextBox Text="{Binding ForgeQuery, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,6,0,0">
                                <Button Content="Install" Height="28" Margin="0,0,4,0" Command="{Binding InstallForgeCommand}" />
                                <Button Content="Updates" Height="28" Margin="2,0,2,0" Command="{Binding CheckUpdatesCommand}" />
                                <Button Content="Import zip" Height="28" Margin="4,0,0,0" Command="{Binding ImportZipCommand}" />
                            </UniformGrid>
                            <ListBox ItemsSource="{Binding ForgeHits}"
                                     SelectedItem="{Binding SelectedForgeHit}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="36" Height="36">
                                                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="3">
                                                    <TextBlock Text="{Binding Initial}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Teaser}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Overwrite">
                        <DockPanel>
                            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                                <Button Content="Assign to mod" Height="28" Margin="0,0,4,4" Command="{Binding AssignOverwriteCommand}" />
                                <Button Content="Discard file" Height="28" Margin="4,0,0,4" Command="{Binding DiscardSelectedOverwriteCommand}" />
                                <Button Content="Discard all Overwrite" Height="28" Margin="0,0,4,0" Command="{Binding DiscardOverwriteCommand}" />
                            </UniformGrid>
                            <ListBox ItemsSource="{Binding OverwriteItems}"
                                     SelectedValue="{Binding SelectedOverwritePath}"
                                     SelectedValuePath="CanonicalPath">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CanonicalPath}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StayInOverwrite}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                            <Setter Property="Opacity" Value="0.7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Log">
                        <TextBox IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 Text="{Binding Status}" />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
        <Border Background="#88000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="48" Height="48" Margin="0,0,0,12" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform />
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:0.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Ellipse Stroke="{DynamicResource MutedBrush}"
                             StrokeThickness="4"
                             Opacity="0.3" />
                    <Path Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 24,4 A 20,20 0 0 1 44,24" />
                </Grid>
                <TextBlock Text="{Binding BusyMessage}"
                           Foreground="{DynamicResource AccentTextBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
