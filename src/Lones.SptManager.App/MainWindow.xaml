<Window x:Class="Lones.SptManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lone's SPT Manager"
        Height="930"
        Width="1330"
        MinHeight="560"
        MinWidth="960"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ProfileIds}"
                          SelectedItem="{Binding ProfileId, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Add" Width="64" Height="26" Margin="8,0,0,0" Command="{Binding AddProfileCommand}" />
                <Button Grid.Column="3" Content="Edit" Width="64" Height="26" Margin="6,0,0,0" Command="{Binding EditProfileCommand}" />
                <TextBlock Grid.Column="4"
                           Text="Lone's SPT Manager"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Margin="4,2,4,6"
                           FontWeight="SemiBold"
                           Text="Installed mods  (0 loads first · drag to reorder · later number wins overlay)" />
                <ListBox x:Name="ModList"
                         ItemsSource="{Binding InventoryItems}"
                         SelectedItem="{Binding SelectedModRow}"
                         AllowDrop="True"
                         PreviewMouseRightButtonDown="ModList_PreviewMouseRightButtonDown"
                         PreviewMouseLeftButtonDown="ModList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ModList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="ModList_PreviewMouseLeftButtonUp"
                         DragOver="ModList_DragOver"
                         DragLeave="ModList_DragLeave"
                         Drop="ModList_Drop">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Enable" Command="{Binding EnableModCommand}" />
                            <MenuItem Header="Disable" Command="{Binding DisableModCommand}" />
                            <Separator />
                            <MenuItem Header="Move up (load earlier)" Command="{Binding PriorityUpCommand}" />
                            <MenuItem Header="Move down (load later)" Command="{Binding PriorityDownCommand}" />
                            <Separator />
                            <MenuItem Header="Import leftover into store" Command="{Binding ImportLeftoverCommand}" />
                            <MenuItem Header="Copy generated files to another profile" Command="{Binding CopyRuntimeCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PriorityLabel}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          VerticalAlignment="Center" />
                                <Grid Grid.Column="2" Width="36" Height="36" Margin="0,0,6,0">
                                    <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="3">
                                        <TextBlock Text="{Binding Initial}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Image Source="{Binding ThumbnailSource}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2" Margin="8,0,4,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Instance" />
                    <TextBlock Text="Game root" Foreground="{DynamicResource MutedBrush}" />
                    <DockPanel Margin="0,2,0,8">
                        <Button DockPanel.Dock="Right" Content="Browse" Width="72" Height="26" Margin="6,0,0,0" Command="{Binding BrowseGameRootCommand}" />
                        <TextBox Text="{Binding GameRoot, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="Manager data" Foreground="{DynamicResource MutedBrush}" />
                    <DockPanel Margin="0,2,0,8">
                        <Button DockPanel.Dock="Right" Content="Browse" Width="72" Height="26" Margin="6,0,0,0" Command="{Binding BrowseManagerDataCommand}" />
                        <TextBox Text="{Binding ManagerData, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,8" Text="Launch" />
                    <TextBlock Text="Mode" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox Margin="0,2,0,8"
                              ItemsSource="{Binding LaunchModeChoices}"
                              SelectedItem="{Binding LaunchMode}" />
                    <TextBlock Text="Join URL (Fika client)" Foreground="{DynamicResource MutedBrush}" />
                    <TextBox Margin="0,2,0,8" Text="{Binding JoinUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Deploy" Height="30" Margin="0,0,4,4" Command="{Binding DeployCommand}" Style="{DynamicResource AccentButton}" />
                        <Button Content="Launch" Height="30" Margin="4,0,0,4" Command="{Binding LaunchCommand}" Style="{DynamicResource AccentButton}" />
                        <Button Content="Harvest" Height="30" Margin="0,0,4,4" Command="{Binding HarvestCommand}" />
                        <Button Content="Bind" Height="30" Margin="4,0,0,4" Command="{Binding BindCommand}" />
                        <Button Content="Import zip" Height="30" Margin="0,0,4,4" Command="{Binding ImportZipCommand}" />
                        <Button Content="Repair" Height="30" Margin="4,0,0,4" Command="{Binding RepairCommand}" />
                    </UniformGrid>
                    <Button Content="Purge manager data"
                            Height="30"
                            Margin="0,0,0,8"
                            Command="{Binding PurgeCommand}" />
                </StackPanel>

                <TabControl>
                    <TabItem Header="The Forge">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Search" Width="72" Height="26" Margin="6,0,0,0" Command="{Binding SearchForgeCommand}" />
                                <TextBox Text="{Binding ForgeQuery, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                                <Button Content="Install" Height="28" Margin="0,0,4,0" Command="{Binding InstallForgeCommand}" />
                                <Button Content="Updates" Height="28" Margin="4,0,0,0" Command="{Binding CheckUpdatesCommand}" />
                            </UniformGrid>
                            <ListBox ItemsSource="{Binding ForgeHits}"
                                     SelectedItem="{Binding SelectedForgeHit}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="36" Height="36">
                                                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="3">
                                                    <TextBlock Text="{Binding Initial}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Teaser}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Overwrite">
                        <DockPanel>
                            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                                <Button Content="Assign to mod" Height="28" Margin="0,0,4,4" Command="{Binding AssignOverwriteCommand}" />
                                <Button Content="Discard file" Height="28" Margin="4,0,0,4" Command="{Binding DiscardSelectedOverwriteCommand}" />
                                <Button Content="Discard all Overwrite" Height="28" Margin="0,0,4,0" Command="{Binding DiscardOverwriteCommand}" />
                            </UniformGrid>
                            <ListBox ItemsSource="{Binding OverwriteItems}"
                                     SelectedItem="{Binding SelectedOverwritePath}" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Log">
                        <TextBox IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 Text="{Binding Status}" />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
