<Window x:Class="Lones.SptManager.App.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile"
        Width="540"
        SizeToContent="Height"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="DeleteButton"
                    DockPanel.Dock="Left"
                    Content="Delete"
                    Width="80"
                    Height="28"
                    HorizontalAlignment="Left"
                    Click="Delete_Click"
                    Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UpdateButton" Content="Update" Width="80" Height="28" Margin="0,0,8,0" Click="Update_Click" Visibility="Collapsed" />
                <Button x:Name="CopyButton" Content="Copy current" Width="110" Height="28" Margin="0,0,8,0" Click="Copy_Click" />
                <Button Content="OK" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" Style="{DynamicResource AccentButton}" />
                <Button Content="Cancel" Width="80" Height="28" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </DockPanel>
        <StackPanel>
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Name" Foreground="{DynamicResource MutedBrush}" />
            <TextBox x:Name="NameBox" Margin="0,2,0,0" />
            <StackPanel x:Name="PackPanel" Margin="0,12,0,0">
                <TextBlock Text="Install from pack (optional)" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock TextWrapping="Wrap"
                           Margin="0,2,0,6"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="HTTPS link or local mods.json (Forge id + installedVersion). List order is load order, 0 first. Skips copy-from." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PackSourceBox" Margin="0,0,8,0" TextChanged="PackSource_Changed" />
                    <Button Grid.Column="1" Content="Browse" Width="72" Height="26" Click="BrowsePack_Click" />
                </Grid>
            </StackPanel>
            <StackPanel x:Name="SavedPackPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="Pack link" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="SavedPackText"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Update reinstalls this pack. Store hits are reused. Pack mods follow the JSON list; mods you added yourself stay unless the pack starts including them." />
            </StackPanel>
            <StackPanel x:Name="CopyFromPanel" Margin="0,12,0,0">
                <TextBlock Text="Copy from another profile" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="CopyFromBox" Margin="0,2,0,8" SelectionChanged="CopyFrom_Changed" />
                <TextBlock Text="Include" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                <CheckBox x:Name="CopySavesBox" Content="Character saves (user profiles)" IsChecked="True" Margin="0,2" />
                <CheckBox x:Name="CopyRuntimeBox" Content="Generated / runtime files" IsChecked="True" Margin="0,2" />
                <CheckBox x:Name="CopyConfigBox" Content="BepInEx configs" IsChecked="True" Margin="0,2" />
                <CheckBox x:Name="CopyOverwriteBox" Content="Overwrite" IsChecked="True" Margin="0,2" />
                <CheckBox x:Name="CopyEnabledBox" Content="Enabled mods and priority" IsChecked="True" Margin="0,2" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
