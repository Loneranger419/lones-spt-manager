<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="TextBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="InputBrush" Color="#1B1B1C" />
